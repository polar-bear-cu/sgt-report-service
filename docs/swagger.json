{
    "swagger": "2.0",
    "info": {
        "description": "Subscription spending report for the Subglutee project",
        "title": "Report Service API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/v1/reports/monthly": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reports"
                ],
                "summary": "spending per month, the last item is the current month (still in progress)",
                "parameters": [
                    {
                        "maximum": 24,
                        "minimum": 1,
                        "type": "integer",
                        "name": "months",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dtos.MonthlySpendingResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ops"
                ],
                "summary": "health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dtos.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dtos.HealthResponse": {
            "type": "object",
            "properties": {
                "serviceName": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "dtos.MonthTotalResponse": {
            "type": "object",
            "properties": {
                "month": {
                    "type": "string"
                },
                "total": {
                    "type": "number"
                }
            }
        },
        "dtos.MonthlySpendingResponse": {
            "type": "object",
            "properties": {
                "averagePerMonth": {
                    "type": "number"
                },
                "months": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dtos.MonthTotalResponse"
                    }
                },
                "total": {
                    "type": "number"
                }
            }
        }
    }
}